# ==========================================
# 1. Telegram Bot Credentials
# ==========================================
BOT_TOKEN=your_telegram_bot_token_here

# ==========================================
# 2. Execution & Safety Mode
# ==========================================
# Set to 'True' for safe dry-run testing (no money spent)
# Set to 'False' for actual cart checkout & live purchase
SIMULATION_MODE=True

# ==========================================
# 3. Rooter Account Credentials / Auth Details
# ==========================================
ROOTER_MOBILE=9876543210
ROOTER_AUTH_TOKEN=your_rooter_bearer_token_here

# ==========================================
# 4. Blinkit Account Credentials / Auth Details
# ==========================================
BLINKIT_MOBILE=9876543210
BLINKIT_AUTH_TOKEN=your_blinkit_token_here

# ==========================================
# 5. Application & Browser Settings
# ==========================================
HEADLESS=true
ENV=production
BROWSER_TIMEOUT_MS=45000

# ==========================================
# 6. Blinkit Dark-Store Localization
# ==========================================
DEFAULT_PINCODE=110001
DEFAULT_LATITUDE=28.6304
DEFAULT_LONGITUDE=77.2177

# ==========================================
# 7. Sniper Tuning & Cloud Credit Optimization
# ==========================================
# Seconds between each restock check (30s cuts CPU usage by 50% compared to 15s)
SNIPE_INTERVAL_SECONDS=30

# Periodic status message in chat (False = off to avoid chat spam and save Telegram requests)
ENABLE_SNIPER_HEARTBEAT=False

# Block heavy images/fonts in browser to minimize memory and bandwidth on Railway/VPS
BLOCK_MEDIA_RESOURCES=True

