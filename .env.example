# ==========================================
# 1. Telegram Bot Credentials
# ==========================================
BOT_TOKEN=8975433711:AAFk_OxMHcTR67JyXsbLwI1l4Ougm69z82I

# Authorized Admin Chat ID for restricted commands (e.g. /snipe amazon 1)
ADMIN_CHAT_ID=

# ==========================================
# 2. Execution & Safety Mode
# ==========================================
# Set to 'True' for safe dry-run testing (no money spent)
# Set to 'False' for actual cart checkout & live purchase
SIMULATION_MODE=False

# ==========================================
# 3. Rooter Account Credentials / Auth Details
# ==========================================
ROOTER_MOBILE=916265656481
ROOTER_AUTH_TOKEN=your_primary_rooter_bearer_token_here

# Multi-Account Support (Persistent across Railway restarts):
# Add all your 5-10 accounts as a comma-separated list of Bearer tokens:
# ROOTER_TOKENS=token1,token2,token3,token4,token5,token6
ROOTER_TOKENS=

# Or as a structured JSON string:
# ROOTER_ACCOUNTS_JSON=[{"token":"token1","label":"Main Acc"},{"token":"token2","label":"Acc 2"}]
ROOTER_ACCOUNTS_JSON=

# ==========================================
# 4. Application & Browser Settings
# ==========================================
HEADLESS=true
ENV=production
BROWSER_TIMEOUT_MS=45000

# ==========================================
# 5. Sniper Tuning & Cloud Credit Optimization
# ==========================================
# Seconds between each restock check (20s recommended for ultra-fast grab)
SNIPE_INTERVAL_SECONDS=20

# Periodic status message in chat (False = off to avoid chat spam)
ENABLE_SNIPER_HEARTBEAT=False

# Block heavy media in browser to minimize memory and bandwidth on Railway
BLOCK_MEDIA_RESOURCES=True
